
# ============================================================
#  FILE: .env
#  LOCATION: instagraim/.env
#  PURPOSE: Secret API Keys & Configuration
# ============================================================

# Server Port
PORT=3000
NODE_ENV=production

# OpenAI API Key (AI Checker ke liye)
# Yahan apni key daalo: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-api-key-here

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# File Upload Limit
MAX_FILE_SIZE_MB=50

# Allowed Websites
ALLOWED_ORIGINS=https://instagraim.in,http://localhost:3000

