// GET /api/youtube/info — Get video info & available formats
app.get('/api/youtube/info', async (req, res) => {
    try {
        const { url } = req.query;

        if (!url || !isValidUrl(url)) {
            return apiResponse(res, 400, false, null, 'Please provide a valid YouTube URL.');
        }

        if (!ytdl.validateURL(url)) {
            return apiResponse(res, 400, false, null, 'Invalid YouTube URL. Please check and try again.');
        }

        const info = await ytdl.getInfo(url);
        const videoDetails = info.videoDetails;

        // Extract available formats
        const formats = info.formats
            .filter(f => f.hasVideo && f.hasAudio)
            .map(f => ({
                itag: f.itag,
                quality: f.qualityLabel,
                mimeType: f.mimeType?.split(';')[0],
                fps: f.fps,
                contentLength: f.contentLength
                    ? (parseInt(f.contentLength) / (1024 * 1024)).toFixed(2) + ' MB'
                    : 'Unknown',
                hasAudio: f.hasAudio,
                hasVideo: f.hasVideo
            }))
            .sort((a, b) => {
                const qualA = parseInt(a.quality) || 0;
                const qualB = parseInt(b.quality) || 0;
                return qualB - qualA;
            });

        // Audio-only formats
        const audioFormats = info.formats
            .filter(f => f.hasAudio && !f.hasVideo)
            .map(f => ({
                itag: f.itag,
                quality: f.audioBitrate + 'kbps',
                mimeType: f.mimeType?.split(';')[0],
                contentLength: f.contentLength
                    ? (parseInt(f.contentLength) / (1024 * 1024)).toFixed(2) + ' MB'
                    : 'Unknown'
            }));

        return apiResponse(res, 200, true, {
            title: videoDetails.title,
            description: videoDetails.shortDescription,
            thumbnail: videoDetails.thumbnails?.pop()?.url,
            duration: videoDetails.lengthSeconds,
            author: videoDetails.author?.name,
            viewCount: videoDetails.viewCount,
            uploadDate: videoDetails.uploadDate,
            videoFormats: formats,
            audioFormats: audioFormats
        });

    } catch (error) {
        console.error('YouTube Info Error:', error.message);
        return apiResponse(res, 500, false, null, 'Failed to fetch video info. The video may be private or restricted.');
    }
});

// GET /api/youtube/download — Download YouTube video
app.get('/api/youtube/download', async (req, res) => {
    try {
        const { url, itag, type } = req.query;

        if (!url || !ytdl.validateURL(url)) {
            return apiResponse(res, 400, false, null, 'Invalid YouTube URL.');
        }

        const info = await ytdl.getInfo(url);
        const title = sanitizeFilename(info.videoDetails.title);

        if (type === 'audio') {
            // Audio-only download (MP3)
            res.setHeader('Content-Disposition', `attachment; filename="${title}.mp3"`);
            res.setHeader('Content-Type', 'audio/mpeg');

            ytdl(url, {
                quality: 'highestaudio',
                filter: 'audioonly'
            }).pipe(res);

        } else {
            // Video download
            const quality = itag || 'highest';
            res.setHeader('Content-Disposition', `attachment; filename="${title}.mp4"`);
            res.setHeader('Content-Type', 'video/mp4');

            ytdl(url, {
                quality: quality,
                filter: format => format.hasVideo && format.hasAudio
            }).pipe(res);
        }

    } catch (error) {
        console.error('YouTube Download Error:', error.message);
        return apiResponse(res, 500, false, null, 'Download failed. Please try again.');
    }
});

