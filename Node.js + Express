// POST /api/pdf/convert — Convert PDF to other formats
app.post('/api/pdf/convert', upload.single('file'), async (req, res) => {
    try {
        const { convertTo } = req.body; // 'word', 'image', 'excel'
        const file = req.file;

        if (!file) {
            return apiResponse(res, 400, false, null, 'Please upload a file.');
        }

        const inputPath = file.path;
        const originalName = path.parse(file.originalname).name;

        switch (convertTo) {
            case 'word': {
                // PDF to Word (DOCX)
                const outputPath = path.join('converted', `${originalName}.docx`);
                const pdfBuffer = fs.readFileSync(inputPath);

                await new Promise((resolve, reject) => {
                    libre.convert(pdfBuffer, '.docx', undefined, (err, result) => {
                        if (err) reject(err);
                        fs.writeFileSync(outputPath, result);
                        resolve();
                    });
                });

                res.download(outputPath, `${originalName}.docx`, () => {
                    fs.unlinkSync(inputPath);
                    fs.unlinkSync(outputPath);
                });
                break;
            }

            case 'image': {
                // PDF to Image (PNG)
                const outputDir = path.join('converted', `${Date.now()}`);
                fs.mkdirSync(outputDir, { recursive: true });

                const converter = pdf2pic.fromPath(inputPath, {
                    density: 200,
                    saveFilename: originalName,
                    savePath: outputDir,
                    format: 'png'
                });

                const result = await converter.bulk(-1); // Convert all pages

                // If single page, send directly; if multiple, zip them
                if (result.length === 1) {
                    res.download(result[0].path, `${originalName}.png`, () => {
                        fs.unlinkSync(inputPath);
                        fs.rmSync(outputDir, { recursive: true });
                    });
                } else {
                    const archiver = require('archiver');
                    const zipPath = path.join('converted', `${originalName}_images.zip`);
                    const output = fs.createWriteStream(zipPath);
                    const archive = archiver('zip', { zlib: { level: 9 } });

                    archive.pipe(output);
                    result.forEach(img => {
                        archive.file(img.path, { name: path.basename(img.path) });
                    });
                    await archive.finalize();

                    output.on('close', () => {
                        res.download(zipPath, `${originalName}_images.zip`, () => {
                            fs.unlinkSync(inputPath);
                            fs.unlinkSync(zipPath);
                            fs.rmSync(outputDir, { recursive: true });
                        });
                    });
                }
                break;
            }

            case 'excel': {
                // PDF to Excel (XLSX)
                const outputPath = path.join('converted', `${originalName}.xlsx`);
                const pdfBuffer = fs.readFileSync(inputPath);

                await new Promise((resolve, reject) => {
                    libre.convert(pdfBuffer, '.xlsx', undefined, (err, result) => {
                        if (err) reject(err);
                        fs.writeFileSync(outputPath, result);
                        resolve();
                    });
                });

                res.download(outputPath, `${originalName}.xlsx`, () => {
                    fs.unlinkSync(inputPath);
                    fs.unlinkSync(outputPath);
                });
                break;
            }

            default:
                fs.unlinkSync(inputPath);
                return apiResponse(res, 400, false, null, 'Invalid conversion type. Use: word, image, or excel.');
        }

    } catch (error) {
        console.error('PDF Convert Error:', error.message);
        if (req.file && fs.existsSync(req.file.path)) {
            fs.unlinkSync(req.file.path);
        }
        return apiResponse(res, 500, false, null, 'Conversion failed. Please try again.');
    }
});

