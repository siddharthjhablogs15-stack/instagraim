// POST /api/ai-checker/analyze — Analyze text for AI content
app.post('/api/ai-checker/analyze', async (req, res) => {
    try {
        const { text } = req.body;

        if (!text || text.trim().length === 0) {
            return apiResponse(res, 400, false, null, 'Please provide text to analyze.');
        }

        const wordCount = text.trim().split(/\s+/).length;
        if (wordCount < 30) {
            return apiResponse(res, 400, false, null, 'Please provide at least 30 words for accurate analysis.');
        }

        // ---- METHOD 1: OpenAI-based detection ----
        const completion = await openai.chat.completions.create({
            model: 'gpt-4',
            messages: [
                {
                    role: 'system',
                    content: `You are an expert AI content detector. Analyze the given text and determine the likelihood it was written by AI vs a human. 
                    
                    Evaluate based on these criteria:
                    1. Perplexity — How predictable is the text?
                    2. Burstiness — Does sentence length/complexity vary naturally?
                    3. Vocabulary diversity — Is word choice natural or formulaic?
                    4. Coherence patterns — Are transitions too smooth/mechanical?
                    5. Repetitive structures — Are there repeated phrase patterns?
                    6. Emotional depth — Does the text show genuine emotion?
                    
                    Respond ONLY in this exact JSON format:
                    {
                        "ai_probability": <number 0-100>,
                        "human_probability": <number 0-100>,
                        "confidence": "<low|medium|high>",
                        "verdict": "<Likely Human Written|Mixed Content|Likely AI Generated>",
                        "analysis": {
                            "perplexity": "<low|medium|high>",
                            "burstiness": "<low|medium|high>",
                            "vocabulary_diversity": "<low|medium|high>",
                            "coherence_pattern": "<natural|mechanical>",
                            "emotional_depth": "<shallow|moderate|deep>"
                        },
                        "explanation": "<brief 2-3 sentence explanation>"
                    }`
                },
                {
                    role: 'user',
                    content: `Analyze this text:\n\n${text.substring(0, 5000)}`
                }
            ],
            temperature: 0.1,
            max_tokens: 500
        });

        const analysisText = completion.choices[0].message.content;
        let analysis;

        try {
            analysis = JSON.parse(analysisText);
        } catch {
            // Fallback if JSON parsing fails
            analysis = {
                ai_probability: 50,
                human_probability: 50,
                confidence: 'low',
                verdict: 'Unable to determine',
                analysis: {},
                explanation: 'Analysis could not be completed accurately. Please try with more text.'
            };
        }

        return apiResponse(res, 200, true, {
            wordCount,
            characterCount: text.length,
            sentenceCount: text.split(/[.!?]+/).filter(s => s.trim()).length,
            ...analysis
        });

    } catch (error) {
        console.error('AI Checker Error:', error.message);

        // ---- METHOD 2: Fallback — Statistical Analysis ----
        // If OpenAI API fails, use basic statistical heuristics
        const text = req.body.text || '';
        const analysis = performStatisticalAnalysis(text);
        return apiResponse(res, 200, true, analysis);
    }
});

// Statistical AI detection fallback (no API needed)
function performStatisticalAnalysis(text) {
    const words = text.trim().split(/\s+/);
    const sentences = text.split(/[.!?]+/).filter(s => s.trim());
    const wordCount = words.length;
    const sentenceCount = sentences.length;

    // 1. Average sentence length
    const avgSentenceLength = wordCount / Math.max(sentenceCount, 1);

    // 2. Vocabulary richness (Type-Token Ratio)
    const uniqueWords = new Set(words.map(w => w.toLowerCase().replace(/[^a-z]/g, '')));
    const ttr = uniqueWords.size / Math.max(wordCount, 1);

    // 3. Sentence length variance (burstiness)
    const sentenceLengths = sentences.map(s => s.trim().split(/\s+/).length);
    const avgLen = sentenceLengths.reduce((a, b) => a + b, 0) / Math.max(sentenceLengths.length, 1);
    const variance = sentenceLengths.reduce((sum, len) => sum + Math.pow(len - avgLen, 2), 0) / Math.max(sentenceLengths.length, 1);
    const stdDev = Math.sqrt(variance);

    // 4. Common AI phrases detection
    const aiPhrases = [
        'in conclusion', 'it is important to note', 'furthermore',
        'in today\'s world', 'it is worth noting', 'in summary',
        'on the other hand', 'in this article', 'as we can see',
        'it is essential', 'plays a crucial role', 'in the realm of',
        'it\'s important to', 'delve into', 'navigating the',
        'landscape of', 'in the ever-evolving', 'harness the power',
        'at the end of the day', 'leverage', 'streamline',
        'cutting-edge', 'game-changer', 'paradigm shift'
    ];
    const lowerText = text.toLowerCase();
    const aiPhraseCount = aiPhrases.filter(phrase => lowerText.includes(phrase)).length;

    // 5. Paragraph uniformity
    const paragraphs = text.split(/\n\n+/).filter(p => p.trim());
    const paraLengths = paragraphs.map(p => p.trim().split(/\s+/).length);
    const paraVariance = paraLengths.length > 1
        ? paraLengths.reduce((sum, len) => {
            const avg = paraLengths.reduce((a, b) => a + b, 0) / paraLengths.length;
            return sum + Math.pow(len - avg, 2);
        }, 0) / paraLengths.length
        : 0;

    // Calculate AI probability score
    let aiScore = 50; // Start neutral

    // Sentence length uniformity (AI tends to be uniform)
    if (stdDev < 5) aiScore += 15;
    else if (stdDev < 8) aiScore += 5;
    else aiScore -= 10;

    // Vocabulary richness (AI tends to have moderate TTR)
    if (ttr < 0.4) aiScore += 10;
    else if (ttr > 0.7) aiScore -= 15;

    // AI phrase detection
    aiScore += Math.min(aiPhraseCount * 5, 20);

    // Average sentence length (AI: 15-25 words typically)
    if (avgSentenceLength >= 15 && avgSentenceLength <= 25) aiScore += 8;
    else aiScore -= 5;

    // Paragraph uniformity
    if (paraVariance < 100 && paragraphs.length > 2) aiScore += 8;

    // Clamp score
    aiScore = Math.max(5, Math.min(95, aiScore));
    const humanScore = 100 - aiScore;

    let verdict, confidence;
    if (aiScore >= 75) { verdict = 'Likely AI Generated'; confidence = 'high'; }
    else if (aiScore >= 55) { verdict = 'Mixed Content'; confidence = 'medium'; }
    else { verdict = 'Likely Human Written'; confidence = 'medium'; }

    return {
        wordCount,
        characterCount: text.length,
        sentenceCount,
        ai_probability: aiScore,
        human_probability: humanScore,
        confidence,
        verdict,
        analysis: {
            perplexity: stdDev < 5 ? 'low' : stdDev < 10 ? 'medium' : 'high',
            burstiness: stdDev > 8 ? 'high' : stdDev > 4 ? 'medium' : 'low',
            vocabulary_diversity: ttr > 0.6 ? 'high' : ttr > 0.4 ? 'medium' : 'low',
            coherence_pattern: aiScore > 60 ? 'mechanical' : 'natural',
            emotional_depth: aiScore > 60 ? 'shallow' : 'moderate',
            ai_phrases_detected: aiPhraseCount
        },
        explanation: `Analysis based on statistical patterns: TTR=${ttr.toFixed(3)}, Sentence StdDev=${stdDev.toFixed(2)}, AI phrases found=${aiPhraseCount}. ${verdict}.`,
        method: 'statistical_fallback'
    };
}

