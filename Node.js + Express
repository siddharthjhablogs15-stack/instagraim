// POST /api/facebook/download — Get Facebook video download links
app.post('/api/facebook/download', async (req, res) => {
    try {
        const { url } = req.body;

        if (!url || !isValidUrl(url)) {
            return apiResponse(res, 400, false, null, 'Please provide a valid Facebook URL.');
        }

        if (!url.includes('facebook.com') && !url.includes('fb.watch') && !url.includes('fb.com')) {
            return apiResponse(res, 400, false, null, 'This is not a valid Facebook URL.');
        }

        const result = await fbDownloader(url);

        if (!result || !result.download) {
            return apiResponse(res, 404, false, null, 'Could not find video. It may be private or deleted.');
        }

        return apiResponse(res, 200, true, {
            platform: 'Facebook',
            title: result.title || 'Facebook Video',
            thumbnail: result.thumbnail || null,
            duration: result.duration || null,
            downloads: [
                {
                    quality: 'HD',
                    url: result.download?.find(d => d.quality === 'hd')?.url || null
                },
                {
                    quality: 'SD',
                    url: result.download?.find(d => d.quality === 'sd')?.url || null
                }
            ].filter(d => d.url)
        });

    } catch (error) {
        console.error('Facebook Download Error:', error.message);
        return apiResponse(res, 500, false, null, 'Failed to fetch Facebook video. Please try again.');
