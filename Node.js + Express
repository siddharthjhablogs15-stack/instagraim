// POST /api/instagram/download — Get Instagram media download links
app.post('/api/instagram/download', async (req, res) => {
    try {
        const { url } = req.body;

        if (!url || !isValidUrl(url)) {
            return apiResponse(res, 400, false, null, 'Please provide a valid Instagram URL.');
        }

        if (!url.includes('instagram.com')) {
            return apiResponse(res, 400, false, null, 'This is not a valid Instagram URL.');
        }

        const result = await instagramGetUrl(url);

        if (!result || !result.url_list || result.url_list.length === 0) {
            return apiResponse(res, 404, false, null, 'Could not find media. The post may be private or deleted.');
        }

        return apiResponse(res, 200, true, {
            platform: 'Instagram',
            mediaCount: result.url_list.length,
            media: result.url_list.map((mediaUrl, index) => ({
                index: index + 1,
                url: mediaUrl,
                type: mediaUrl.includes('.mp4') ? 'video' : 'image'
            }))
        });

    } catch (error) {
        console.error('Instagram Download Error:', error.message);
        return apiResponse(res, 500, false, null, 'Failed to fetch Instagram media. Please try again.');
    }
});

